PORT=8020

# Obtain SMTP settings from the mailbox administrator. Blank values disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Use a sender address verified by the SMTP provider and a mailbox monitored by SAEL.
SAEL_FROM=
SAEL_QUOTE_TO=sael.karabalta@saelglobal.com

# Optional: exact immediate proxy IPs, comma separated. Leave blank by default.
# Set only if Hosting.kg confirms these proxies overwrite X-Real-IP with the client IP.
TRUST_PROXY_IPS=

# Public HTTPS origin of this installation, no path or trailing slash.
# For local development leave blank. On Plesk use your actual domain.
PUBLIC_ORIGIN=

# One-time first-administrator setup secret: generate 32+ random characters.
# npm run admin:setup can generate it into the private .env without printing it.
CMS_SETUP_TOKEN=

# Optional absolute private persistent directory OUTSIDE public/. Default: data next to server.js.
CMS_DATA_DIR=
CMS_MEDIA_LIMIT_MB=512

# Optional AI provider. Keep the key private; never add it to CMS content or public files.
# With no key the assistant uses relevant approved materials and offers specialist contact.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ASSISTANT_DAILY_AI_LIMIT=200
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_MAX_CONVERSATIONS=200
